{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2024",
    "baseUrl": "./",
    "paths": {
      "@application/*": [
        "./application/*"
      ],
      "@bin/*": [
        "./bin/*"
      ],
      "@config/*": [
        "./config/*"
      ],
      "@database/*": [
        "./database/*"
      ],
      "@extensions/*": [
        "./extensions/*"
      ],
      "@hooks/*": [
        "./hooks/*"
      ],
      "@start/*": [
        "./start/*"
      ],
      "@test/*": [
        "./test/*"
      ]
    }
  },
  "module": {
    "type": "es6"
  }
}
