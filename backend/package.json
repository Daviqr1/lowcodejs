    "migrate:backfill-storage-location:prod": "node database/migrations/migrate-backfill-storage-location.js",
    "migrate:visibility-index": "node --import @swc-node/register/esm-register database/migrations/migrate-add-visibility-index.ts",
    "migrate:visibility-index:prod": "node database/migrations/migrate-add-visibility-index.js"
